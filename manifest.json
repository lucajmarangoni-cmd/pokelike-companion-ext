{
  "manifest_version": 3,
  "name": "Pokelike Companion",
  "version": "0.5.4",
  "description": "Unofficial helper panel for Pokelike: boss win chances, S+ to C grades, Dex tracker, map route and optional shiny auto-reroll.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pokelike Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://pokelike.xyz/*"
      ],
      "js": [
        "src/companion.js"
      ],
      "css": [
        "src/companion.css"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
